# Public game launch URLs. Production builds require absolute HTTPS values for every entry.
VITE_RETRO_RUSH_URL=http://localhost:5174
VITE_SPIN_THE_BOTTLE_URL=http://localhost:5175
VITE_RUS_RULETI_URL=http://localhost:5176
VITE_DRAW_AND_GUESS_URL=http://localhost:5177
VITE_IMPOSTER_URL=http://localhost:5178
VITE_TANK_BATTLE_URL=http://localhost:5179
VITE_HIDE_AND_SEEK_URL=http://localhost:5180
VITE_WHEEL_OF_FORTUNE_URL=http://localhost:5181

# Production-oriented room service. Set VITE_ROOM_SERVICE=mock only for isolated UI work.
VITE_API_URL=http://localhost:5281
VITE_ROOM_SERVICE=real

# Covers backend cold-start budget (90s) + generation (40s) + response margin.
# Increase at build time if AiQuestions__ColdStartTimeoutSeconds is increased.
VITE_AI_PREPARATION_TIMEOUT_SECONDS=135
